        "boundclass",
        "CAPSLOCK",
        "clampf",
        "colr",
        "consola",
        "ESCAPEKEY",
        "EXCLAM",
        "LALT",
        "LCTRL",
        "LINALG",
        "LMASK",
        "LSHIFT",
        "meditor",
        "Moji",
        "RALT",
        "RCTRL",
        "RSHIFT",
        "SDLK",
        "seguiemj"
    ],
}
